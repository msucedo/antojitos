# Ranking mundial (Vercel Functions + Upstash Redis). En Vercel los pone la integración de Upstash
# del Marketplace; en local, `npx vercel env pull .env.local`.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Nombres alternativos que acepta api/ranking.ts (Upstash directo, sin Marketplace).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Opcional: permite `DELETE /api/ranking?id=<uuid>` con `Authorization: Bearer <token>` para retirar a un
# jugador (queda baneado). Sin rate limit propio: usa 32+ caracteres aleatorios (`openssl rand -hex 32`).
ADMIN_TOKEN=
